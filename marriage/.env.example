DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Development default. Render Blueprint sets DJANGO_DEBUG=False and HTTPS settings.
DJANGO_DEBUG=True
# Comma-separated hostnames (no scheme or port). Example: royalvenue.in,www.royalvenue.in
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated full origins, including https://, used for cross-origin CSRF checks.
# Set comma-separated HTTPS origins in production; Netlify example: https://*.netlify.app
CSRF_TRUSTED_ORIGINS=
# Keep SQLite for local development. Render supplies PostgreSQL via DATABASE_URL:
# DATABASE_URL=postgres://royalvenue:change-me@127.0.0.1:5432/royalvenue
DATABASE_URL=sqlite:///database/royalvenue.sqlite3
# Render persistent disk mount path for uploaded media (local default is ./media).
# MEDIA_ROOT=/opt/render/project/src/marriage/media
# Use secure cookies and HTTPS redirects in production (configure proxy HTTPS headers first).
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
# Optional Meta WhatsApp Cloud API configuration
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_FALLBACK_NUMBER=918961103171
# SMTP settings for enquiry notification email. Leave EMAIL_HOST empty to use console/log fallback.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@royalvenue.in
ENQUIRY_NOTIFICATION_EMAIL=

# Manual production checklist (the Render Blueprint sets the core values):
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<generate a unique, long random secret; do not commit it>
# DJANGO_ALLOWED_HOSTS=royalvenue.in,www.royalvenue.in
# CSRF_TRUSTED_ORIGINS=https://*.netlify.app,https://royalvenue.in,https://www.royalvenue.in
# CSRF_COOKIE_SECURE=True
# SESSION_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=<smtp username>
# EMAIL_HOST_PASSWORD=<smtp app password>
# EMAIL_USE_TLS=True
# ENQUIRY_NOTIFICATION_EMAIL=events@royalvenue.in
# Set the WHATSAPP_* values above only when the Meta Cloud API app is configured.
